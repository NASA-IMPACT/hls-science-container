#!/bin/bash
set -euo pipefail

IMAGE="${IMAGE:-hls-science-container:benchmark}"
OUTPUT_DIR="${OUTPUT_DIR:-benchmark-output}"

mkdir -p "$OUTPUT_DIR"

docker run --rm \
    -v "$(realpath "$OUTPUT_DIR"):/output" \
    -e BENCHMARK_S2_GRANULE_IDS \
    -e BENCHMARK_LS_GRANULE_IDS \
    -e BENCHMARK_INPUT_BUCKET \
    -e BENCHMARK_INPUT_PREFIX \
    -e BENCHMARK_AUX_BUCKET \
    -e BENCHMARK_AUX_PREFIX \
    -e BENCHMARK_FMASK_VERSIONS \
    -e BENCHMARK_NUM_THREADS \
    -e AWS_ACCESS_KEY_ID \
    -e AWS_SECRET_ACCESS_KEY \
    -e AWS_DEFAULT_REGION \
    -e PIXI_FROZEN=true \
    -e BENCHMARK_OUTPUT_DIR=/output \
    "$IMAGE" \
    "mkdir -p /output && pixi run -e benchmark pytest src/hls-nextgen-orchestration/tests/benchmarks -v"
