{
  "product": "L30",
  "version": "2.0",
  "default_tolerance": 1e-06,
  "attributes": {
    "$include": "common/attributes.json",
    "LANDSAT_PRODUCT_ID": {
      "required": true,
      "type": "string",
      "cog_tag": "LANDSAT_PRODUCT_ID",
      "cmr_additional_attribute": "LANDSAT_PRODUCT_ID",
      "stac_property": null,
      "golden": "exact"
    },
    "MGRS_TILE_ID": {
      "required": true,
      "type": "string",
      "cog_tag": "SENTINEL2_TILEID",
      "cmr_additional_attribute": "MGRS_TILE_ID",
      "stac_property": null,
      "golden": "exact"
    },
    "THERM_SCALE_FACTOR": {
      "required": true,
      "type": "number",
      "cog_tag": null,
      "cmr_additional_attribute": "THERM_SCALE_FACTOR",
      "stac_property": null,
      "value_from": "B10.scale_factor",
      "golden": "exact"
    },
    "TIRS_SSM_MODEL": {
      "required": true,
      "type": "string",
      "cog_tag": "TIRS_SSM_MODEL",
      "cmr_additional_attribute": "TIRS_SSM_MODEL",
      "stac_property": null,
      "golden": "exact"
    },
    "TIRS_SSM_POSITION_STATUS": {
      "required": true,
      "type": "string",
      "cog_tag": "TIRS_SSM_POSITION_STATUS",
      "cmr_additional_attribute": "TIRS_SSM_POSITION_STATUS",
      "stac_property": null,
      "golden": "exact"
    },
    "USGS_SOFTWARE": {
      "required": true,
      "type": "string",
      "cog_tag": "USGS_SOFTWARE",
      "cmr_additional_attribute": "USGS_SOFTWARE",
      "stac_property": null,
      "golden": "volatile"
    }
  },
  "assets": {
    "$include": [
      "common/angles.json",
      "common/fmask.json"
    ],
    "B01": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B01"
    },
    "B02": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B02"
    },
    "B03": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B03"
    },
    "B04": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B04"
    },
    "B05": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B05"
    },
    "B06": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B06"
    },
    "B07": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B07"
    },
    "B09": {
      "$include": "common/encodings/reflectance.json",
      "stac_asset": "B09"
    },
    "B10": {
      "$include": "common/encodings/thermal.json",
      "stac_asset": "B10"
    },
    "B11": {
      "$include": "common/encodings/thermal.json",
      "stac_asset": "B11"
    }
  },
  "known_gaps": [
    {
      "id": "stac-no-raster-ext",
      "surface": "stac",
      "check": "asset.raster",
      "target": null,
      "reason": "hls-cmr_stac does not add the raster extension, so STAC assets carry no nodata/scale/offset."
    },
    {
      "id": "prod-l30-angle-attrs",
      "surface": "golden",
      "check": "value",
      "target": "SZA|SAA|VZA|VAA",
      "reason": "Prod L30 angle COGs predate the restore of NASA-IMPACT/hls-landsat-tile@60205b0 (nodata/scale/offset on L30 angle SDS); remove once references are regenerated."
    }
  ]
}
